{
  "name": "fitui",
  "version": "2.0.1",
  "description": "基于vue3+vite+unocss的UI组件库",
  "main": "index.js",
  "config": {
    "commitizen": {
      "path": "git-cz"
    }
  },
  "scripts": {
    "commit": "git-cz",
    "cm": "git add . && git status && git-cz",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "changelog:init": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
    "docs:build": "pnpm -C packages/fit-docs run d:build",
    "docs:build:dev": "pnpm -C packages/fit-docs run build:dev",
    "docs:dev": "pnpm -C packages/fit-docs run dev",
    "demo:dev": "pnpm -C packages/fit-test run dev",
    "ui:build": "pnpm -C packages/fit-ui run build",
    "ui:dev": "pnpm -C packages/fit-ui run dev",
    "ui:test": "pnpm -C packages/fit-ui run test:run",
    "ui:lint": "pnpm -C packages/fit-ui run lint",
    "release": "bash release.sh",
    "preinstall": "node ./scripts/preinstall.js",
    "prepare": "husky"
  },
  "keywords": [
    "fit",
    "ui",
    "vue3",
    "typescript",
    "unocss",
    "vite"
  ],
  "author": "geniusmanyxh",
  "license": "ISC",
  "dependencies": {
    "@geniusmanyxh/fit-ui": "workspace:^",
    "vite": "^7.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "20.3.1",
    "@commitlint/config-conventional": "20.3.1",
    "@types/less": "^3.0.8",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitejs/plugin-vue-jsx": "5.1.3",
    "basic-ftp": "^5.1.0",
    "conventional-changelog-atom": "^5.0.0",
    "cpy": "^12.1.0",
    "fast-glob": "^3.3.3",
    "git-cz": "^4.9.0",
    "husky": "^9.1.7",
    "typescript": "^5.9.3",
    "vite-plugin-dts": "^4.5.4"
  }
}
